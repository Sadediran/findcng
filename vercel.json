{
  "functions": {
    "api/admin.js": {
      "includeFiles": "data/{stations,stats}.json"
    },
    "api/chat.js": {
      "includeFiles": "data/{chat-knowledge,stations}.json",
      "maxDuration": 60
    },
    "api/confirmations.js": {
      "includeFiles": "data/stations.json"
    },
    "api/listing-reports.js": {
      "includeFiles": "data/stations.json"
    },
    "api/live-centres.js": {
      "maxDuration": 30
    },
    "api/news.js": {
      "includeFiles": "data/news-seed.json"
    },
    "api/operator.js": {
      "includeFiles": "data/stations.json"
    },
    "api/reports.js": {
      "includeFiles": "data/stations.json"
    }
  },
  "headers": [
    {
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self'; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
        }
      ],
      "source": "/(.*)"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ],
      "source": "/data/stations.json"
    },
    {
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ],
      "source": "/data/postcodes.json"
    }
  ]
}